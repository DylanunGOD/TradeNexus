# Copien este archivo como .env.local y llénenlo con los datos de su proyecto
# (Supabase → Project Settings → API Keys).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Solo para los scripts de la carpeta scripts/ (seed y pruebas). NUNCA la
# pongan en Vercel ni en código del navegador: salta todas las reglas RLS.
SUPABASE_SERVICE_ROLE_KEY=
